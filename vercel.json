{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/painel/observatorio.html" },
    { "source": "/(.*)", "destination": "/painel/$1" }
  ],
  "headers": [
    {
      "source": "/painel/motor/duckdb.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    }
  ]
}
